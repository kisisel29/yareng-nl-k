{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/((?!api/|google.*\\.html|robots\\.txt|favicon\\.|apple-touch-icon|.*\\.(png|jpg|jpeg|webp|svg|ico|txt|xml|webmanifest)$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
