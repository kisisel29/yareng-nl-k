{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "simalar.vercel.app" }],
      "destination": "https://www.gumussimalar.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.simalar.vercel.app" }],
      "destination": "https://www.gumussimalar.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
